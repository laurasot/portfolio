---
import styles from './Projects.module.css';

interface Tag {
    name: string;
    highlighted?: boolean;
}

interface ProjectLink {
    url: string;
    label: string;
}

interface Project {
    id: number;
    title: string;
    description: string;
    category: 'Música' | 'AI' | 'Híbrido' | 'En desarrollo';
    icon: string;
    tags: Tag[];
    link?: string;
    links?: ProjectLink[];
}

const projects: Project[] = [
    {
        id: 1,
        title: 'MUSIC UNDER THE HOOD',
        description:
            'Sistema de análisis musical automatizado que combina procesamiento digital de señales, modelos transformer pre-entrenados y teoría musical para extraer características avanzadas: acordes, tonalidad, modos, tempo, ritmo, timbre y estructura armónica. Implementado en Python con Librosa, PyTorch y Transformers, con soporte CUDA para procesamiento acelerado.',
        category: 'En desarrollo',
        icon: '',
        link: 'https://github.com/laurasot/music-intelligence-backend/tree/develop',
        tags: [
            { name: 'Python', highlighted: true },
            { name: 'Librosa', highlighted: true },
            { name: 'Machine Learning' },
            { name: 'Music Theory' },
            { name: 'Audio Processing' }
        ],
    },
    {
        id: 2,
        title: 'Interpretaciones de Cueca',
        description:
            'Interpretaciones personales de cuecas experimentales del compositor Patricio Fuentes, explorando texturas rítmicas con un enfoque expresivo contemporáneo.',
        category: 'Música',
        icon: '',
        tags: [
            { name: 'Piano', highlighted: true },
            { name: 'Cueca' },
            { name: 'Folclor' },
            { name: 'Performance' }
        ],
    },
    {
        id: 3,
        title: 'SPEAKFLOW',
        description:
            'Copiloto para reuniones virtuales pensado para situaciones donde el usuario no domina completamente el idioma de la conversación: cuando entiende solo una parte de una pregunta, tarda en procesarla, se queda en blanco o sabe qué quiere responder pero no encuentra las palabras correctas. SpeakFlow escucha ambos lados de la conversación en tiempo real, interpreta el contexto con un modelo de IA de latencia ultrabaja y utiliza similitud semántica para detectar los momentos en los que realmente hace falta intervenir. Esto permite diferenciar entre una pausa normal y una situación en la que el usuario necesita apoyo, generando una posible respuesta contextual en menos de 3 segundos, en el idioma adecuado y alineada con lo que se está discutiendo. Funciona en segundo plano y es independiente de la plataforma de videollamadas, por lo que puede usarse en entrevistas, reuniones técnicas, ventas o soporte, siempre que el idioma pueda afectar la claridad, velocidad o seguridad al responder.',
        category: 'En desarrollo',
        icon: '',
        links: [
            { url: 'https://github.com/laurasot/speakflow-api', label: 'Backend API' },
            { url: 'https://github.com/laurasot/speakflow-desktop', label: 'Desktop App' }
        ],
        tags: [
            { name: 'Electron + React', highlighted: true },
            { name: 'TypeScript' },
            { name: 'FastAPI' },
            { name: 'LangChain' },
            { name: 'Binary WebSocket' },
            { name: 'Speech-to-Text' },
            { name: 'LLM' },
            { name: 'Semantic Similarity' },
            { name: 'Real-time Audio' },
            { name: 'Low Latency' },
            { name: 'Provider Pattern' },
            { name: 'Groq' },
            { name: 'Deepgram' },
            { name: 'Asyncio' }
            ]
        },
    {
        id: 4,
        title: 'Traductor de Lengua de Señas con IA',
        description:
            'Sistema de traducción a lengua de señas impulsado por IA generativa para empresa líder de medios en Chile. Arquitectura multilenguaje (Python + Go + TypeScript) diseñada para cumplir requisitos de latencia crítica (<5s). Implementa traducciones inteligentes con RAG, transcripción en tiempo real con streaming, modelos open source optimizados, y renderizado mediante biblioteca de videos pregrabados de señas.',
        category: 'AI',
        icon: '',
        tags: [
            { name: 'Generative AI', highlighted: true },
            { name: 'RAG', highlighted: true },
            { name: 'Python' },
            { name: 'Go' },
            { name: 'TypeScript' },
            { name: 'Real-time Streaming' },
            { name: 'Low Latency' },
            { name: 'Accessibility' }
        ],
    },
    {
        id: 5,
        title: 'Asistente de Ventas con IA en Tiempo Real',
        description:
            'Sistema de reconocimiento contextual en tiempo real para ingenieros comerciales que identifica automáticamente menciones de proyectos empresariales durante conversaciones naturales. Experiencia inmersiva con detección sub-3 segundos que analiza el discurso del usuario y asocia referencias implícitas a proyectos específicos. Implementa streaming de video sobre protocolo TLS optimizado para latencia ultra-baja, permitiendo respuestas visuales instantáneas que potencian las capacidades de venta.',
        category: 'AI',
        icon: '',
        tags: [
            { name: 'Real-time AI', highlighted: true },
            { name: 'NLP', highlighted: true },
            { name: 'Video Streaming' },
            { name: 'TLS Protocol' },
            { name: 'Ultra-low Latency' },
            { name: 'Sales Intelligence' },
            { name: 'Context Detection' }
        ],
    },
    {
        id: 6,
        title: 'INCIDENT MULTIAGENT',
        description:
            'Asistente inteligente para respuesta a incidentes AWS que combina razonamiento en lenguaje natural con acceso directo a CloudWatch y búsqueda web contextual. Arquitectura multi-agente desplegada en Amazon Bedrock AgentCore: un supervisor orquesta agentes especialistas (monitoreo vía MCP tools y contexto web) implementados con Strands Agents SDK. Streaming de eventos en tiempo real, memoria de corto y largo plazo, e infraestructura completa como código con AWS CDK v2.',
        category: 'AI',
        icon: '',
        link: 'https://github.com/laurasot/incident-multiagent',
        tags: [
            { name: 'Multi-Agent', highlighted: true },
            { name: 'AWS Bedrock', highlighted: true },
            { name: 'AgentCore' },
            { name: 'Strands SDK' },
            { name: 'MCP' },
            { name: 'CloudWatch' },
            { name: 'CDK' },
            { name: 'DevOps' }
        ],
    }
    /*{
        id: 7,
        title: 'Computer Vision para Partituras',
        description:
            'Sistema de reconocimiento óptico de partituras musicales usando redes neuronales convolucionales.',
        category: 'En desarrollo',
        icon: '',
        tags: [
            { name: 'Computer Vision', highlighted: true },
            { name: 'CNN' },
            { name: 'OCR' },
            { name: 'Music Notation' }
        ],
    },*/
];
---

<section class={styles.projectsContainer} id="proyectos">
    <div class={styles.grainTexture} />
    <div class={styles.projectsContent}>
        <div class={styles.sectionHeader}>
            <h2 class={styles.sectionTitle}>Proyectos</h2>
            <p class={styles.sectionSubtitle}>
                Exploraciones en la frontera entre música y tecnología
            </p>
        </div>

        <div class={styles.projectsGrid}>
            {projects.map((project, index) => {
                const indexStr = `0${index + 1}`;
                return (
                    <article
                        class={styles.projectCard}
                        data-index={indexStr}
                        style={`--index: ${index}`}
                    >
                        <span class={styles.projectCategory}>
                            {project.category}
                        </span>

                        <h3 class={styles.projectTitle}>{project.title}</h3>
                        <p class={styles.projectDescription}>
                            {project.description}
                        </p>

                        <div class={styles.projectTags}>
                            {project.tags.map((tag) => (
                                <span 
                                    class={`${styles.projectTag} ${tag.highlighted ? styles.highlighted : ''}`}
                                >
                                    {tag.name}
                                </span>
                            ))}
                        </div>

                        {project.link && (
                            <a
                                href={project.link}
                                class={styles.projectLink}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Ver proyecto
                                <span class={styles.linkArrow}>→</span>
                            </a>
                        )}
                        {project.links && (
                            <div class={styles.projectLinks}>
                                {project.links.map((link) => (
                                    <a
                                        href={link.url}
                                        class={styles.projectLink}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {link.label}
                                        <span class={styles.linkArrow}>→</span>
                                    </a>
                                ))}
                            </div>
                        )}
                    </article>
                );
            })}
        </div>
    </div>
</section>

