---
import styles from './About.module.css';

interface Skill {
    name: string;
    highlighted?: boolean;
}

const musicSkills: Skill[] = [
    { name: 'Cueca and Salsa' },
    { name: 'Composition', highlighted: true },
    { name: 'Music Theory' },
    { name: 'Performance' },
    { name: 'Ableton' }
];

const techSkills: Skill[] = [
    { name: 'Generative AI', highlighted: true },
    { name: 'NLP', highlighted: true },
    { name: 'Machine Learning' },
    { name: 'Deep Learning' },
    { name: 'Data Science' },
    { name: 'Python', highlighted: true },
    { name: 'Computer Vision' },
];

const devSkills: Skill[] = [
    { name: 'AWS' },
    { name: 'CDK' },
    { name: 'React', highlighted: true },
    { name: 'TypeScript', highlighted: true },
    { name: 'Node.js' },
    { name: 'Java' },
    { name: 'PostgreSQL' },
    { name: 'Git' },
    { name: 'Docker' }
];
---

<section class={styles.aboutContainer} id="sobre-mi">
    <div class={styles.grainTexture} />
    <div class={styles.aboutContent}>
        <div class={styles.sectionHeader}>
            <h2 class={styles.sectionTitle}>Sobre Mí</h2>
        </div>

        <div class={styles.aboutGrid}>
            <div class={styles.aboutText}>
                <p class={`${styles.aboutParagraph} ${styles.aboutParagraphDesktop}`}>
                    Me alegra que estés aquí. Sí, el diseño brutalista es intencional—no, tu navegador no está roto. Siempre me ha gustado el arte y pensé: ¿por qué hacer una web convencional cuando puedes hacer algo que la gente recuerde (para bien o para mal)?
                </p>
                <p class={`${styles.aboutParagraph} ${styles.aboutParagraphDesktop}`}>
                    El piano me transporta; la tecnología me impulsa. Empecé a los 19, sin títulos enmarcables en la pared, solo curiosidad y una laptop. Resulta que no necesitas un papel para construir cosas interesantes.
                </p>
                <p class={`${styles.aboutParagraph} ${styles.aboutParagraphDesktop}`}>
                    Hoy combino full-stack, datos e IA para diseñar soluciones que —espero— inspiren más que asusten.
                </p>
                <p class={`${styles.aboutParagraph} ${styles.aboutParagraphMobile} ${styles.aboutParagraphMobileFirst}`}>
                    Sí, el diseño brutalista es intencional. No, tu navegador no está roto. Hago webs que la gente recuerde (para bien o para mal).
                </p>
                <p class={`${styles.aboutParagraph} ${styles.aboutParagraphMobile}`}>
                    El piano me transporta; la tecnología me impulsa. Empecé a los 19, sin títulos enmarcables, solo curiosidad y una laptop.
                </p>
                <p class={`${styles.aboutParagraph} ${styles.aboutParagraphMobile}`}>
                    Hoy construyo con full-stack e IA soluciones que —espero— inspiren más que asusten.
                </p>
            </div>

            <div class={styles.skillsContainer}>
                <div class={styles.skillCategory}>
                    <div class={styles.skillHeader}>
                        <h3 class={styles.skillTitle}>AI ENGINEERING</h3>
                    </div>
                    <div class={styles.skillList}>
                        {techSkills.map((skill, index) => (
                            <span 
                                class={`${styles.skillTag} ${skill.highlighted ? styles.highlighted : ''}`}
                                style={`--index: ${index}`}
                            >
                                {skill.name}
                            </span>
                        ))}
                    </div>
                </div>

                <div class={styles.skillCategory}>
                    <div class={styles.skillHeader}>
                        <h3 class={styles.skillTitle}>CLOUD ENGINEER</h3>
                    </div>
                    <div class={styles.skillList}>
                        {devSkills.map((skill, index) => (
                            <span 
                                class={`${styles.skillTag} ${skill.highlighted ? styles.highlighted : ''}`}
                                style={`--index: ${index}`}
                            >
                                {skill.name}
                            </span>
                        ))}
                    </div>
                </div>
                <div class={styles.skillCategory}>
                    <div class={styles.skillHeader}>
                        <h3 class={styles.skillTitle}>MÚSICA</h3>
                    </div>
                    <div class={styles.skillList}>
                        {musicSkills.map((skill, index) => (
                            <span 
                                class={`${styles.skillTag} ${skill.highlighted ? styles.highlighted : ''}`}
                                style={`--index: ${index}`}
                            >
                                {skill.name}
                            </span>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

