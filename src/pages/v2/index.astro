---
import V2Layout from '../../v2/layouts/V2Layout.astro';
import data from '../../v2/data/projects.es';
import script from '../../v2/data/es';
import { validate } from '../../v2/data/validate';

validate(script);
---

<V2Layout
  lang="es"
  title={data.name}
  alt={{ lang: 'en', href: '/en/v2', label: data.ui.langLabel }}
  detect
>
  <main>
    <h1>{data.name}</h1>
    <a href={data.projectsHref}>{data.ui.exit}</a>
  </main>
</V2Layout>
